{
  "id": "lunar-industries-claude",
  "version": "0.3.0",
  "title": "Lunar Industries - Claude",
  "engine": "^0.1.1",
  "permissions": [
    "shell"
  ],
  "contributes": {
    "requires": [
      "git"
    ],
    "uses": [
      "tasks"
    ],
    "pages": [
      {
        "id": "claude",
        "path": "/lunar-industries/claude",
        "title": "Claude",
        "order": 40
      }
    ],
    "commands": [
      {
        "id": "lunar-industries-claude.newSession",
        "title": "Session Claude…",
        "group": "Lunar Industries - Claude"
      },
      {
        "id": "lunar-industries-claude.startTask",
        "title": "Démarrer…",
        "group": "Lunar Industries - Claude"
      }
    ],
    "kanban": {
      "actions": [
        {
          "command": "lunar-industries-claude.startTask",
          "title": "Démarrer…",
          "setting": "lunar-industries-claude.enabled",
          "groups": [
            "todo"
          ]
        },
        {
          "command": "lunar-industries-claude.newSession",
          "title": "Session Claude…",
          "setting": "lunar-industries-claude.enabled"
        }
      ]
    },
    "events": [
      "lunar-industries-claude.sessions",
      "lunar-industries-claude.session"
    ],
    "background": true,
    "settings": {
      "title": "Lunar Industries - Claude",
      "panel": true,
      "fields": [
        {
          "key": "lunar-industries-claude.enabled",
          "type": "toggle",
          "title": "Sessions Claude dans l’app (expérimental)",
          "help": "Pilote Claude Code depuis l’application avec l’Agent SDK et ton compte Claude. Anthropic n’a pas explicitement approuvé cet usage d’un abonnement par une application tierce : à activer en connaissance de cause.",
          "default": false
        },
        {
          "key": "lunar-industries-claude.root",
          "type": "text",
          "title": "Racine de l’espace de travail",
          "help": "Où démarrent les sessions et où vivent les verrous du créneau exécutable. Vide : le dossier que partagent les dépôts de la session, sinon le dossier personnel.",
          "placeholder": "~/workspaces",
          "default": ""
        },
        {
          "key": "lunar-industries-claude.settingSources",
          "type": "text",
          "title": "Réglages chargés par une session",
          "help": "Réglages, hooks, skills et CLAUDE.md, comme dans le terminal. Les skills de l’application sont toujours chargés.",
          "default": "user, project, local",
          "hidden": true
        },
        {
          "key": "lunar-industries-claude.defaultMode",
          "type": "choice",
          "title": "Mode d’une nouvelle session",
          "options": [
            {
              "value": "default",
              "label": "Demander avant chaque action"
            },
            {
              "value": "acceptEdits",
              "label": "Accepter les modifications de fichiers"
            },
            {
              "value": "plan",
              "label": "Mode plan"
            },
            {
              "value": "auto",
              "label": "Automatique"
            },
            {
              "value": "bypassPermissions",
              "label": "Tout autoriser sans demander"
            }
          ],
          "default": "default",
          "help": "Le mode proposé au départ d’une nouvelle session ; on peut en changer dans la fenêtre de la session sans modifier ce réglage. Les outils de l’application qui écrivent (tâches, forge, git) demandent toujours confirmation."
        },
        {
          "key": "lunar-industries-claude.defaultModel",
          "type": "text",
          "title": "Modèle de la dernière session",
          "default": "",
          "hidden": true
        },
        {
          "key": "lunar-industries-claude.defaultEffort",
          "type": "text",
          "title": "Effort de la dernière session",
          "default": "",
          "hidden": true
        },
        {
          "key": "lunar-industries-claude.notify",
          "type": "text",
          "title": "Notifications",
          "help": "decision (une décision attendue), turn (Claude a terminé), error, slot (le créneau est pris).",
          "default": "decision, error, slot",
          "hidden": true
        },
        {
          "key": "lunar-industries-claude.stagingBranch",
          "type": "text",
          "title": "Branche de staging",
          "default": "",
          "placeholder": "factory"
        },
        {
          "key": "lunar-industries-claude.productionBranch",
          "type": "text",
          "title": "Branche de production",
          "default": "",
          "placeholder": "orbit"
        },
        {
          "key": "lunar-industries-claude.stagingJob",
          "type": "text",
          "title": "Job de déploiement en staging",
          "help": "{env} : l’environnement.",
          "default": "",
          "placeholder": "deploy:{env}"
        },
        {
          "key": "lunar-industries-claude.productionJob",
          "type": "text",
          "title": "Job de déploiement en production",
          "default": "",
          "placeholder": "deploy:prod"
        },
        {
          "key": "lunar-industries-claude.stagingEnvs",
          "type": "text",
          "title": "Environnements de staging",
          "default": "",
          "placeholder": "staging-01, staging-02",
          "help": "Séparés par des virgules."
        },
        {
          "key": "lunar-industries-claude.stagingEnv",
          "type": "text",
          "title": "Environnement de staging par défaut",
          "default": "",
          "placeholder": "staging-02"
        },
        {
          "key": "lunar-industries-claude.testStatus",
          "type": "text",
          "title": "Statut d’une tâche en test",
          "default": "",
          "placeholder": "Staging/Test",
          "help": "Le nom exact d’une option du statut des tâches."
        },
        {
          "key": "lunar-industries-claude.repos",
          "type": "text",
          "title": "Réglages par dépôt",
          "default": "{}",
          "hidden": true
        }
      ]
    }
  }
}

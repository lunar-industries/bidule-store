{
  "id": "lunar-industries-kanban",
  "version": "0.4.0",
  "title": "Lunar Industries - Kanban",
  "engine": "^0.2.0",
  "contributes": {
    "needs": [
      {
        "object": "task",
        "optional": true
      },
      {
        "object": "repository",
        "optional": true
      },
      {
        "object": "branch",
        "optional": true
      },
      {
        "object": "review",
        "optional": true
      },
      {
        "object": "pipeline",
        "optional": true
      }
    ],
    "pages": [
      {
        "id": "kanban",
        "path": "/lunar-industries/kanban",
        "title": "Kanban",
        "order": 0
      }
    ],
    "settings": {
      "title": "Lunar Industries - Kanban",
      "panel": true,
      "fields": [
        {
          "key": "lunar-industries-kanban.hiddenBranches",
          "type": "text",
          "title": "Branches d’intégration",
          "help": "Séparées par des virgules, absentes du bac des branches sans tâche et de la fenêtre « Lier des branches » (la branche par défaut de chaque dépôt l’est toujours).",
          "default": "main, master, develop, launchpad, factory, orbit"
        },
        {
          "key": "lunar-industries-kanban.hidden",
          "type": "text",
          "title": "Colonnes masquées",
          "default": "[]",
          "hidden": true
        }
      ]
    }
  }
}

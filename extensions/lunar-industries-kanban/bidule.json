{
  "id": "lunar-industries-kanban",
  "version": "0.2.0",
  "title": "Lunar Industries - Kanban",
  "engine": "^0.1.2",
  "contributes": {
    "uses": [
      "tasks",
      "git"
    ],
    "pages": [
      {
        "id": "kanban",
        "path": "/lunar-industries/kanban",
        "title": "Kanban",
        "order": 0
      }
    ],
    "settings": {
      "title": "Lunar Industries - Kanban",
      "panel": true,
      "fields": [
        {
          "key": "lunar-industries-kanban.hiddenBranches",
          "type": "text",
          "title": "Branches d'intégration",
          "help": "Masquées du bac des branches sans tâche et de la fenêtre « Lier des branches » (avec la branche par défaut du dépôt).",
          "default": "main, master, develop, launchpad, factory, orbit"
        },
        {
          "key": "lunar-industries-kanban.hidden",
          "type": "text",
          "title": "Colonnes masquées",
          "default": "[]",
          "hidden": true
        }
      ]
    }
  }
}

{
  "id": "lunar-industries-kanban",
  "version": "0.8.2",
  "title": "Kanban",
  "engine": "^0.3.1",
  "dependencies": {
    "lunar-industries-common": "^0.1.0"
  },
  "contributes": {
    "points": [
      {
        "id": "kanban",
        "title": "Cartes du Kanban"
      }
    ],
    "needs": [
      {
        "object": "task",
        "optional": true
      },
      {
        "object": "repository",
        "optional": true
      },
      {
        "object": "branch",
        "optional": true
      },
      {
        "object": "review",
        "optional": true
      },
      {
        "object": "pipeline",
        "optional": true
      }
    ],
    "pages": [
      {
        "id": "kanban",
        "path": "/lunar-industries/kanban",
        "title": "Kanban",
        "order": 0
      }
    ],
    "settings": {
      "title": "Kanban",
      "panel": true,
      "fields": [
        {
          "key": "lunar-industries-kanban.order",
          "type": "text",
          "title": "Ordre des colonnes",
          "default": "[]",
          "hidden": true
        },
        {
          "key": "lunar-industries-kanban.hidden",
          "type": "text",
          "title": "Colonnes masquées",
          "default": "[]",
          "hidden": true
        },
        {
          "key": "lunar-industries-kanban.statusMerge",
          "type": "text",
          "title": "Statuts réunis dans une autre colonne",
          "default": "{}",
          "hidden": true
        },
        {
          "key": "lunar-industries-kanban.toggled",
          "type": "text",
          "title": "Colonnes pliées ou dépliées",
          "default": "[]",
          "hidden": true
        },
        {
          "key": "lunar-industries-kanban.role",
          "type": "text",
          "title": "Rôle montré",
          "default": "\"all\"",
          "hidden": true
        }
      ]
    },
    "background": true,
    "shortcuts": [
      {
        "keys": "↑ ↓ ← →",
        "title": "Passer d’une carte à l’autre",
        "where": "sur le tableau"
      },
      {
        "keys": "Entrée",
        "title": "Ouvrir la tâche dans son outil",
        "where": "sur une carte"
      },
      {
        "keys": "Menu",
        "title": "Menu de la carte (aussi Maj+F10)",
        "where": "sur une carte"
      },
      {
        "keys": "Alt+← →",
        "title": "Déplacer la carte vers la colonne voisine",
        "where": "sur une carte"
      },
      {
        "keys": "Espace",
        "title": "Sélectionner la carte (Maj : jusqu’à elle)",
        "where": "sur une carte"
      },
      {
        "keys": "Mod+A",
        "title": "Sélectionner toutes les cartes affichées",
        "where": "sur le tableau"
      },
      {
        "keys": "Échap",
        "title": "Tout désélectionner",
        "where": "sur le tableau"
      },
      {
        "keys": "/",
        "title": "Chercher une tâche",
        "where": "sur le tableau"
      }
    ]
  }
}

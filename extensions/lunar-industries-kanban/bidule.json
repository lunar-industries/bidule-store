{
  "id": "lunar-industries-kanban",
  "version": "0.7.0",
  "title": "Kanban",
  "engine": "^0.3.0",
  "dependencies": {
    "lunar-industries-common": "^0.1.0"
  },
  "contributes": {
    "points": [
      {
        "id": "kanban",
        "title": "Cartes du Kanban"
      }
    ],
    "needs": [
      {
        "object": "task",
        "optional": true
      },
      {
        "object": "repository",
        "optional": true
      },
      {
        "object": "branch",
        "optional": true
      },
      {
        "object": "review",
        "optional": true
      },
      {
        "object": "pipeline",
        "optional": true
      }
    ],
    "pages": [
      {
        "id": "kanban",
        "path": "/lunar-industries/kanban",
        "title": "Kanban",
        "order": 0
      }
    ],
    "settings": {
      "title": "Kanban",
      "panel": true,
      "fields": [
        {
          "key": "lunar-industries-kanban.order",
          "type": "text",
          "title": "Ordre des colonnes",
          "default": "[]",
          "hidden": true
        },
        {
          "key": "lunar-industries-kanban.hidden",
          "type": "text",
          "title": "Colonnes masquées",
          "default": "[]",
          "hidden": true
        },
        {
          "key": "lunar-industries-kanban.statusMerge",
          "type": "text",
          "title": "Statuts réunis dans une autre colonne",
          "default": "{}",
          "hidden": true
        },
        {
          "key": "lunar-industries-kanban.toggled",
          "type": "text",
          "title": "Colonnes pliées ou dépliées",
          "default": "[]",
          "hidden": true
        },
        {
          "key": "lunar-industries-kanban.trayOpen",
          "type": "text",
          "title": "Tiroir des branches ouvert",
          "default": "true",
          "hidden": true
        }
      ]
    }
  }
}
